*.png
*.jpg
*.jpeg
*.mp4
*.mov
!web/public/**/*.png
!web/tests/**/*.png
# python / node
__pycache__/
*.pyc
.venv/
node_modules/
dist/
.DS_Store
# settings sweep output (lab/sweep.py)
sweep-out/
