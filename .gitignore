# secrets and local config
.env
*.local.json
local.json
# recordings (keep only curated, scrubbed sessions in data/sessions/keep/)
data/sessions/*
!data/sessions/keep/
# never commit images or video
*.png
*.jpg
*.jpeg
*.mp4
*.mov
!web/public/**/*.png
!web/tests/**/*.png
# python / node
__pycache__/
*.pyc
.venv/
node_modules/
dist/
.DS_Store
# the witnesses' keys and records stay on their devices (#866)
data/witness/
witness_ed25519*
witness_keys.json
