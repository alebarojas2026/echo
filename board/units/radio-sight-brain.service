[Unit]
Description=Radio Sight brain (features, training, live predictions)
After=network-online.target radio-sight-bus.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=-@REPO@/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m brain.main
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
