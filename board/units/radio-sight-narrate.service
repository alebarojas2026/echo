[Unit]
Description=Radio Sight narrator
After=network-online.target radio-sight-brain.service radio-sight-llm.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=-@REPO@/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m narrator.narrate
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
