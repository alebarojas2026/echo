[Unit]
Description=Radio Sight privacy meter (images stored, bytes sent out)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
EnvironmentFile=-@REPO@/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# "+": only this line runs as root, to load the counter (a reload keeps the count). "-": if it
# fails, the meter still starts and says why it can't count, instead of looping.
ExecStartPre=-+/usr/sbin/nft -f @REPO@/board/privacy.nft
# Per-port counts for --explain; on their own line so they can't stop the meter.
ExecStartPre=-+/usr/sbin/nft -f @REPO@/board/privacy-ports.nft
ExecStart=@PYTHON@ -m board.privacy run
# Reading an nftables counter needs CAP_NET_ADMIN. It's the only privilege the meter gets.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
# /run/radio-sight-privacy/status.json, gone when the meter stops, so the screen never sees an old reading.
RuntimeDirectory=radio-sight-privacy
# /var/lib/radio-sight-privacy: where counting started, and resets.log.
StateDirectory=radio-sight-privacy
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
