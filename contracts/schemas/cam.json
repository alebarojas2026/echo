{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/echo/contracts/schemas/cam.json",
  "$comment": "Section 4. From teacher/camwatch.py every 1 s and on any change.",
