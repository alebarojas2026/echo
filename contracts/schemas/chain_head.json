{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/deadzone/contracts/schemas/chain_head.json",
  "$comment": "Section 13: the board's chain head, sent on the bus every 5 s. seq is the record number of the head, not a per-producer counter, and t is the board's clock when it was sent. The last three fields are optional: what the brain copies into state.chain.",
  "$ref": "common.json#/$defs/envelope",
  "properties": {
    "type": {
      "const": "chain_head"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verified": {
      "type": "boolean"
    },
    "witnesses_ok": {
      "type": "integer",
      "minimum": 0
    },
    "witnesses": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "hash"
  ],
  "unevaluatedProperties": false
}
