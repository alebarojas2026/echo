{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/deadzone/contracts/schemas/label.json",
  "$comment": "Section 4. One per processed camera frame. clipped:true means zone and foot_m are null.",
  "$ref": "common.json#/$defs/envelope",
  "properties": {
    "type": {"const": "label"},
    "frame": {"type": "integer", "minimum": 0},
    "mode": {"$ref": "common.json#/$defs/label_mode"},
    "persons_in_frame": {"type": "integer", "minimum": 0},
    "present": {"type": "boolean"},
    "zone": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
    "foot_m": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "motion": {"$ref": "common.json#/$defs/motion"},
    "conf": {"type": "number", "minimum": 0, "maximum": 1},
    "clipped": {"type": "boolean"}
  },
  "required": ["frame", "mode", "persons_in_frame", "present", "zone", "foot_m", "motion", "conf", "clipped"],
  "unevaluatedProperties": false,
  "if": {"properties": {"clipped": {"const": true}}, "required": ["clipped"]},
  "then": {"properties": {"zone": {"type": "null"}, "foot_m": {"type": "null"}}}
}
