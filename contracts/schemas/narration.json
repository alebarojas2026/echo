{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/deadzone/contracts/schemas/narration.json",
  "$comment": "Section 4. model is null when source is template. event_kind is an event kind or recap; a recap allows 45 words, every other narration 16 (section 6).",
  "$ref": "common.json#/$defs/envelope",
  "properties": {
    "type": {"const": "narration"},
    "text": {"type": "string"},
    "event_id": {"type": "string"},
    "event_kind": {"anyOf": [{"$ref": "common.json#/$defs/event_kind"}, {"const": "recap"}]},
    "gen_ms": {"type": "number", "minimum": 0},
    "source": {"$ref": "common.json#/$defs/narration_source"},
    "model": {"type": ["string", "null"]}
  },
  "required": ["text", "event_id", "event_kind", "gen_ms", "source", "model"],
  "unevaluatedProperties": false,
  "allOf": [
    {"if": {"properties": {"source": {"const": "template"}}, "required": ["source"]},
     "then": {"properties": {"model": {"type": "null"}}},
     "else": {"properties": {"model": {"type": "string"}}}},
    {"if": {"properties": {"event_kind": {"const": "recap"}}, "required": ["event_kind"]},
     "then": {"properties": {"text": {"$ref": "common.json#/$defs/recap_text"}}},
     "else": {"properties": {"text": {"$ref": "common.json#/$defs/narration_text"}}}}
  ]
}
