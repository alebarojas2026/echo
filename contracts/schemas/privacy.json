{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/deadzone/contracts/schemas/privacy.json",
  "$comment": "Section 11: the answer of GET /privacy. Not a bus message: no envelope. ok false carries no numbers: never a zero in place of an unknown.",
  "type": "object",
  "properties": {"ok": {"type": "boolean"}, "images": {"type": "integer", "minimum": 0}, "bytes_out": {"type": "integer", "minimum": 0},
                 "since_t": {"type": "integer", "minimum": 0}, "t": {"type": "integer", "minimum": 0}, "why": {"type": "string", "minLength": 1}},
  "required": ["ok"],
  "additionalProperties": false,
  "if": {"properties": {"ok": {"const": true}}},
  "then": {"required": ["images", "bytes_out", "since_t", "t"], "properties": {"why": false}},
  "else": {"required": ["why"], "properties": {"images": false, "bytes_out": false, "since_t": false}}
}
