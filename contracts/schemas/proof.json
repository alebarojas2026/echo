{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/deadzone/contracts/schemas/proof.json",
  "$comment": "Section 7, served as /proof.json. A number not yet measured is null.",
  "$defs": {
    "count": {"type": ["integer", "null"], "minimum": 0},
    "num": {"type": ["number", "null"], "minimum": 0},
    "score": {"type": "object", "properties": {"correct": {"$ref": "#/$defs/count"}, "total": {"$ref": "#/$defs/count"}}, "required": ["correct", "total"]},
    "ci95": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2}
  },
  "type": "object",
  "properties": {
    "zone": {
      "$ref": "#/$defs/score",
      "properties": {"ci95": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2},
                     "sessions": {"type": "array", "items": {"type": "string"}}, "walkers": {"$ref": "#/$defs/count"}, "method": {"type": "string"},
                     "majority_class_correct": {"$comment": "Optional: what always naming the commonest zone would score, of the same total.", "$ref": "#/$defs/count"}},
      "required": ["ci95", "sessions", "walkers", "method"], "unevaluatedProperties": false},
    "presence": {
      "$comment": "Optional. Somebody there or nobody, per second on held-out cycles. always_empty_correct is what always saying nobody would score, of the same total.",
      "$ref": "#/$defs/score",
      "properties": {"always_empty_correct": {"$ref": "#/$defs/count"}, "cycles": {"$ref": "#/$defs/count"}, "method": {"type": "string"}},
      "required": ["always_empty_correct", "cycles", "method"], "unevaluatedProperties": false},
    "threshold_zone": {"$ref": "#/$defs/score", "unevaluatedProperties": false},
    "person_vs_object": {"$ref": "#/$defs/score", "properties": {"tray_placements": {"$ref": "#/$defs/count"}},
                         "required": ["tray_placements"], "unevaluatedProperties": false},
    "false_alarms_per_min": {"$ref": "#/$defs/num"}, "train_s": {"$ref": "#/$defs/num"},
    "ms_per_decision": {"type": "object", "properties": {"p50": {"$ref": "#/$defs/num"}, "p95": {"$ref": "#/$defs/num"}},
                        "required": ["p50", "p95"], "additionalProperties": false},
    "watts": {
      "type": "object",
      "properties": {"idle": {"$ref": "#/$defs/num"}, "teaching": {"$ref": "#/$defs/num"}, "radio_only": {"$ref": "#/$defs/num"},
                     "source": {"type": ["string", "null"]}},
      "required": ["idle", "teaching", "radio_only", "source"], "additionalProperties": false},
    "bytes_out": {"$ref": "#/$defs/count"}, "images_stored": {"$ref": "#/$defs/count"}, "models_on_board": {"$ref": "#/$defs/count"},
    "measured_at": {"type": "string"}, "commit": {"type": "string"},
    "security": {
      "$comment": "Optional. Every unmeasured value is null. fewer_devices names nodes and links from radio/nodes.json.",
      "type": "object",
      "properties": {
        "detection": {
          "type": "object",
          "properties": {"entries": {"$ref": "#/$defs/count"}, "detected": {"$ref": "#/$defs/count"}, "ci95": {"$ref": "#/$defs/ci95"},
                         "armed_entries": {"$ref": "#/$defs/count"}, "intrusions": {"$ref": "#/$defs/count"}, "intrusion_ci95": {"$ref": "#/$defs/ci95"},
                         "within_s": {"type": "number", "exclusiveMinimum": 0}},
          "required": ["entries", "detected", "ci95", "armed_entries", "intrusions", "intrusion_ci95", "within_s"], "additionalProperties": false},
        "false_alarms": {
          "type": "object",
          "properties": {"presence_events": {"$ref": "#/$defs/count"}, "intrusions": {"$ref": "#/$defs/count"}, "duration_s": {"$ref": "#/$defs/num"},
                         "armed_duration_s": {"$ref": "#/$defs/num"}, "presence_per_hour": {"$ref": "#/$defs/num"}, "intrusions_per_hour": {"$ref": "#/$defs/num"}},
          "required": ["presence_events", "intrusions", "duration_s", "armed_duration_s", "presence_per_hour", "intrusions_per_hour"],
          "additionalProperties": false},
        "fewer_devices": {"type": "array", "items": {
          "type": "object",
          "properties": {"name": {"type": "string"}, "nodes": {"type": "array", "items": {"$ref": "common.json#/$defs/node"}},
                         "links": {"$ref": "common.json#/$defs/links"}, "zone": {"$ref": "#/$defs/score", "unevaluatedProperties": false},
                         "presence": {"type": "object",
                                      "properties": {"entries": {"$ref": "#/$defs/count"}, "detected": {"$ref": "#/$defs/count"}, "ci95": {"$ref": "#/$defs/ci95"}},
                                      "required": ["entries", "detected", "ci95"], "additionalProperties": false}},
          "required": ["name", "nodes", "links", "zone", "presence"], "additionalProperties": false}}
      },
      "required": ["detection", "false_alarms", "fewer_devices"], "additionalProperties": false}
  },
  "required": ["zone", "threshold_zone", "person_vs_object", "false_alarms_per_min", "train_s", "ms_per_decision", "watts",
               "bytes_out", "images_stored", "models_on_board", "measured_at", "commit"],
  "additionalProperties": false
}
