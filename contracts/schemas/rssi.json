{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/deadzone/contracts/schemas/rssi.json",
  "$comment": "Section 4. Link id = <tx>><rx>:<kind>, so tx, rx and kind must agree with link.",
  "$ref": "common.json#/$defs/envelope",
  "properties": {
    "type": {"const": "rssi"},
    "link": {"$ref": "common.json#/$defs/link"},
    "kind": {"enum": ["wifi", "ble"]},
    "tx": {"$ref": "common.json#/$defs/node"},
    "rx": {"$ref": "common.json#/$defs/node"},
    "dbm": {"type": "number"}
  },
  "required": ["link", "kind", "tx", "rx", "dbm"],
  "unevaluatedProperties": false,
  "allOf": [
    {"if": {"properties": {"link": {"const": "pi5>unoq:wifi"}}}, "then": {"properties": {"tx": {"const": "pi5"}, "rx": {"const": "unoq"}, "kind": {"const": "wifi"}}}},
    {"if": {"properties": {"link": {"const": "pi5>unoq:ble"}}}, "then": {"properties": {"tx": {"const": "pi5"}, "rx": {"const": "unoq"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "east>unoq:ble"}}}, "then": {"properties": {"tx": {"const": "east"}, "rx": {"const": "unoq"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "west>unoq:ble"}}}, "then": {"properties": {"tx": {"const": "west"}, "rx": {"const": "unoq"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "east>pi5:ble"}}}, "then": {"properties": {"tx": {"const": "east"}, "rx": {"const": "pi5"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "west>pi5:ble"}}}, "then": {"properties": {"tx": {"const": "west"}, "rx": {"const": "pi5"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "pi5b>unoq:ble"}}}, "then": {"properties": {"tx": {"const": "pi5b"}, "rx": {"const": "unoq"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "pi5>pi5b:wifi"}}}, "then": {"properties": {"tx": {"const": "pi5"}, "rx": {"const": "pi5b"}, "kind": {"const": "wifi"}}}},
    {"if": {"properties": {"link": {"const": "pi5>pi5b:ble"}}}, "then": {"properties": {"tx": {"const": "pi5"}, "rx": {"const": "pi5b"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "east>pi5b:ble"}}}, "then": {"properties": {"tx": {"const": "east"}, "rx": {"const": "pi5b"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "west>pi5b:ble"}}}, "then": {"properties": {"tx": {"const": "west"}, "rx": {"const": "pi5b"}, "kind": {"const": "ble"}}}},
    {"if": {"properties": {"link": {"const": "pi5b>pi5:ble"}}}, "then": {"properties": {"tx": {"const": "pi5b"}, "rx": {"const": "pi5"}, "kind": {"const": "ble"}}}}
  ]
}
