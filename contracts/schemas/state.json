{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/deadzone/contracts/schemas/state.json",
  "$comment": "Section 5, brain -> screen, including what it sends before readings, a baseline or training. xray arrays must hold w*h cells (checked in check.py).",
  "$ref": "common.json#/$defs/envelope",
  "properties": {
    "type": {"const": "state"},
    "cam": {"$ref": "common.json#/$defs/cam_state"},
    "router": {"$ref": "common.json#/$defs/router_spot"},
    "links": {"type": "array", "items": {
      "$comment": "Listed once it has a reading. Before the baseline base_dbm, drop_db and expected_hz are null and status is ok or stale.",
      "type": "object",
      "properties": {"id": {"$ref": "common.json#/$defs/link"}, "dbm": {"type": "number"}, "base_dbm": {"type": ["number", "null"]}, "drop_db": {"type": ["number", "null"]},
                     "rate_hz": {"type": "number", "minimum": 0}, "expected_hz": {"type": ["number", "null"], "minimum": 0},
                     "status": {"enum": ["ok", "stale", "blind"]}, "why": {"type": "number"}},
      "required": ["id", "dbm", "base_dbm", "drop_db", "rate_hz", "expected_hz", "status", "why"], "additionalProperties": false,
      "if": {"properties": {"base_dbm": {"type": "null"}}}, "then": {"properties": {"drop_db": {"type": "null"}, "expected_hz": {"type": "null"}, "status": {"enum": ["ok", "stale"]}}},
      "else": {"properties": {"drop_db": {"type": "number"}, "expected_hz": {"type": "number"}}}}},
    "health": {"type": "object", "properties": {"status": {"enum": ["ok", "degraded", "blind"]}, "blind": {"$ref": "common.json#/$defs/links"}, "reason": {"enum": ["rate", "jump", null]}},
      "required": ["status", "blind", "reason"], "additionalProperties": false},
    "pred": {
      "$comment": "null before training, while blind, while recalibrating and while the router is off S-home. present false -> zone 0, zone_set [] and motion null; motion is null only then.",
      "type": ["object", "null"],
      "properties": {"present": {"type": "boolean"}, "kind": {"enum": ["person", "object", "none"]}, "zone": {"$ref": "common.json#/$defs/zone"},
                     "zone_set": {"type": "array", "items": {"$ref": "common.json#/$defs/zone"}},
                     "probs": {"$comment": "[empty, z1, z2]: one entry for empty, then one per zone in radio/nodes.json.", "type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 3},
                     "motion": {"enum": ["moving", "still", null]}, "still_s": {"type": "number", "minimum": 0}, "why": {"$ref": "common.json#/$defs/links"}},
      "required": ["present", "kind", "zone", "zone_set", "probs", "motion", "still_s", "why"], "additionalProperties": false,
      "if": {"type": "object", "properties": {"present": {"const": false}}}, "then": {"properties": {"zone": {"const": 0}, "zone_set": {"maxItems": 0}, "motion": {"type": "null"}}},
      "else": {"properties": {"motion": {"$ref": "common.json#/$defs/motion"}}}},
    "objects": {"type": "array", "items": {
      "type": "object",
      "properties": {"xy_m": {"$ref": "common.json#/$defs/xy_m"}, "near": {"$ref": "common.json#/$defs/near"}, "since_s": {"type": "number", "minimum": 0}, "drop_db": {"type": "number"}},
      "required": ["xy_m", "near", "since_s", "drop_db"], "additionalProperties": false}},
    "xray": {
      "$comment": "null before the first baseline.",
      "type": ["object", "null"],
      "properties": {"w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1}, "cell_m": {"type": "number", "exclusiveMinimum": 0},
                     "origin_m": {"$ref": "common.json#/$defs/xy_m"}, "moving_db": {"type": "array", "items": {"type": "number"}},
                     "static_db": {"type": "array", "items": {"type": "number"}}, "n_links": {"type": "integer", "minimum": 0}},
      "required": ["w", "h", "cell_m", "origin_m", "moving_db", "static_db", "n_links"], "additionalProperties": false},
    "alert": {
      "$comment": "zone is null only while nothing is counting. limit_s is zones[zone].still_alert_s (10 s in both zones of the desk layout; null for a zone that never alerts).",
      "type": "object",
      "properties": {"state": {"enum": ["none", "counting", "check_on"]}, "zone": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
                     "still_s": {"type": "number", "minimum": 0}, "limit_s": {"type": ["number", "null"]}},
      "required": ["state", "zone", "still_s", "limit_s"], "additionalProperties": false,
      "if": {"properties": {"state": {"enum": ["counting", "check_on"]}}}, "then": {"properties": {"zone": {"type": "integer"}}}},
    "checkin": {"type": ["object", "null"], "properties": {"t": {"type": "integer", "minimum": 0}, "link": {"$ref": "common.json#/$defs/link"}},
                "required": ["t", "link"], "additionalProperties": false},
    "advice": {
      "type": ["object", "null"],
      "properties": {"id": {"type": "string"}, "cause": {"type": "string"}, "near": {"$ref": "common.json#/$defs/near"}, "xy_m": {"$ref": "common.json#/$defs/xy_m"},
                     "link": {"$ref": "common.json#/$defs/link"}, "to_spot": {"enum": ["S-W30", "S-E30"]}, "move_m": {"$ref": "common.json#/$defs/xy_m"},
                     "dist_change_m": {"type": "number"}, "text": {"type": "string"}, "before_dbm": {"type": "number"},
                     "after_dbm": {"type": ["number", "null"]}, "why": {"$ref": "common.json#/$defs/links"}},
      "required": ["id", "cause", "near", "xy_m", "link", "to_spot", "move_m", "dist_change_m", "text", "before_dbm", "after_dbm", "why"],
      "additionalProperties": false},
    "narration": {
      "type": ["object", "null"],
      "$comment": "Mirrors the last narration, a recap included. It carries no event_kind, so its text gets the recap limit (section 6).",
      "properties": {"text": {"$ref": "common.json#/$defs/recap_text"}, "event_id": {"type": "string"}, "t": {"type": "integer", "minimum": 0},
                     "source": {"$ref": "common.json#/$defs/narration_source"}, "gen_ms": {"type": "number", "minimum": 0}},
      "required": ["text", "event_id", "t", "source", "gen_ms"], "additionalProperties": false},
    "teacher": {
      "$comment": "null when the camera is off. Mirrors the last label, so motion is null when nobody is there.",
      "type": ["object", "null"],
      "properties": {"present": {"type": "boolean"}, "zone": {"$ref": "common.json#/$defs/zone"}, "motion": {"enum": ["moving", "still", null]}},
      "required": ["present", "zone", "motion"], "additionalProperties": false},
    "hall": {
      "$comment": "Optional (section 5): a missing hall reads as []. One row per hall link that has a reading. stale -> activity 0 and moving false.",
      "type": "array", "items": {
        "type": "object",
        "properties": {"id": {"$ref": "common.json#/$defs/hall_link"}, "tx": {"$ref": "common.json#/$defs/hall_node"}, "rx": {"$ref": "common.json#/$defs/receiver"},
                       "xy_m": {"anyOf": [{"$ref": "common.json#/$defs/xy_m"}, {"type": "null"}]}, "activity": {"type": "number", "minimum": 0, "maximum": 1},
                       "moving": {"type": "boolean"}, "rate_hz": {"type": "number", "minimum": 0}, "stale": {"type": "boolean"}},
        "required": ["id", "tx", "rx", "xy_m", "activity", "moving", "rate_hz", "stale"], "additionalProperties": false,
        "if": {"properties": {"stale": {"const": true}}}, "then": {"properties": {"activity": {"const": 0}, "moving": {"const": false}}}}},
    "armed": {"$comment": "Optional (section 6, Armed): true after arm {on: true}; missing means false.", "type": "boolean"},
    "model": {
      "$comment": "ver, train_s and ms_per_decision are null before training. Once trained, ver is set; train_s and ms_per_decision stay null when nothing was measured (the fake brain).",
      "type": "object",
      "properties": {"trained": {"type": "boolean"}, "ver": {"type": ["string", "null"]}, "train_s": {"type": ["number", "null"], "minimum": 0},
                     "ms_per_decision": {"type": ["number", "null"], "minimum": 0}, "windows": {"type": "integer", "minimum": 0},
                     "train_sessions": {"type": "array", "items": {"type": "string"}}, "training": {
                       "$comment": "null unless a fit is running or a lesson is on. lesson is there only during a live lesson; agree <= of is checked in check.py.",
                       "type": ["object", "null"],
                       "properties": {"started_t": {"type": "integer", "minimum": 0}, "progress": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                                      "sessions": {"type": "array", "items": {"type": "string"}},
                                      "lesson": {"type": "object",
                                                 "properties": {"started_t": {"type": "integer", "minimum": 0}, "agree": {"type": "integer", "minimum": 0, "maximum": 10},
                                                                "of": {"type": "integer", "minimum": 0, "maximum": 10}, "fits": {"type": "integer", "minimum": 0},
                                                                "fitting": {"type": "boolean"}},
                                                 "required": ["started_t", "agree", "of", "fits", "fitting"], "additionalProperties": false}},
                       "required": ["started_t", "progress", "sessions"], "additionalProperties": false}},
      "required": ["trained", "ver", "train_s", "ms_per_decision", "windows", "train_sessions", "training"], "additionalProperties": false,
      "if": {"properties": {"trained": {"const": true}}}, "then": {"properties": {"ver": {"type": "string"}}}},
    "board": {"$comment": "a field it can't read is null", "type": "object",
              "properties": {"cpu_temp_c": {"type": ["number", "null"]}, "cpu_mhz": {"type": ["number", "null"], "minimum": 0}, "cpu_pct": {"type": ["number", "null"], "minimum": 0}},
      "required": ["cpu_temp_c", "cpu_mhz", "cpu_pct"], "additionalProperties": false}
  },
  "required": ["cam", "router", "links", "health", "pred", "objects", "xray", "alert", "checkin", "advice", "narration", "teacher", "model", "board"],
  "unevaluatedProperties": false
}
