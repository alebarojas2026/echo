{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alebarojas2026/deadzone/contracts/schemas/state.json",
  "$comment": "Section 5, brain -> screen. xray arrays must hold w*h cells (checked in check.py).",
  "$ref": "common.json#/$defs/envelope",
  "properties": {
    "type": {"const": "state"},
    "cam": {"$ref": "common.json#/$defs/cam_state"},
    "router": {"$ref": "common.json#/$defs/router_spot"},
    "links": {"type": "array", "items": {
      "type": "object",
      "properties": {"id": {"$ref": "common.json#/$defs/link"}, "dbm": {"type": "number"}, "base_dbm": {"type": "number"}, "drop_db": {"type": "number"},
                     "rate_hz": {"type": "number", "minimum": 0}, "expected_hz": {"type": "number", "minimum": 0},
                     "status": {"enum": ["ok", "stale", "blind"]}, "why": {"type": "number"}},
      "required": ["id", "dbm", "base_dbm", "drop_db", "rate_hz", "expected_hz", "status", "why"], "additionalProperties": false}},
    "health": {
      "type": "object",
      "properties": {"status": {"enum": ["ok", "degraded", "blind"]}, "blind": {"$ref": "common.json#/$defs/links"}, "reason": {"enum": ["rate", "jump", null]}},
      "required": ["status", "blind", "reason"], "additionalProperties": false},
    "pred": {
      "$comment": "null before training, while blind, while recalibrating and while the router is off S-home.",
      "type": ["object", "null"],
      "properties": {"present": {"type": "boolean"}, "kind": {"enum": ["person", "object", "none"]}, "zone": {"$ref": "common.json#/$defs/zone"},
                     "zone_set": {"type": "array", "items": {"$ref": "common.json#/$defs/zone"}},
                     "probs": {"$comment": "[empty, z1, z2, z3, z4]", "type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 5, "maxItems": 5},
                     "motion": {"$ref": "common.json#/$defs/motion"}, "still_s": {"type": "number", "minimum": 0}, "why": {"$ref": "common.json#/$defs/links"}},
      "required": ["present", "kind", "zone", "zone_set", "probs", "motion", "still_s", "why"], "additionalProperties": false},
    "objects": {"type": "array", "items": {
      "type": "object",
      "properties": {"xy_m": {"$ref": "common.json#/$defs/xy_m"}, "near": {"$ref": "common.json#/$defs/node"}, "since_s": {"type": "number", "minimum": 0}, "drop_db": {"type": "number"}},
      "required": ["xy_m", "near", "since_s", "drop_db"], "additionalProperties": false}},
    "xray": {
      "type": "object",
      "properties": {"w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1}, "cell_m": {"type": "number", "exclusiveMinimum": 0},
                     "origin_m": {"$ref": "common.json#/$defs/xy_m"}, "moving_db": {"type": "array", "items": {"type": "number"}},
                     "static_db": {"type": "array", "items": {"type": "number"}}, "n_links": {"type": "integer", "minimum": 0}},
      "required": ["w", "h", "cell_m", "origin_m", "moving_db", "static_db", "n_links"], "additionalProperties": false},
    "alert": {
      "$comment": "limit_s comes from zones[zone].still_alert_s, which is null for zones 2 and 3.",
      "type": "object",
      "properties": {"state": {"enum": ["none", "counting", "check_on"]}, "zone": {"$ref": "common.json#/$defs/zone"},
                     "still_s": {"type": "number", "minimum": 0}, "limit_s": {"type": ["number", "null"]}},
      "required": ["state", "zone", "still_s", "limit_s"], "additionalProperties": false},
    "checkin": {
      "type": ["object", "null"],
      "properties": {"t": {"type": "integer", "minimum": 0}, "link": {"$ref": "common.json#/$defs/link"}},
      "required": ["t", "link"], "additionalProperties": false},
    "advice": {
      "type": ["object", "null"],
      "properties": {"id": {"type": "string"}, "cause": {"type": "string"}, "near": {"$ref": "common.json#/$defs/node"}, "xy_m": {"$ref": "common.json#/$defs/xy_m"},
                     "link": {"$ref": "common.json#/$defs/link"}, "to_spot": {"enum": ["S-W30", "S-E30"]}, "move_m": {"$ref": "common.json#/$defs/xy_m"},
                     "dist_change_m": {"type": "number"}, "text": {"type": "string"}, "before_dbm": {"type": "number"},
                     "after_dbm": {"type": ["number", "null"]}, "why": {"$ref": "common.json#/$defs/links"}},
      "required": ["id", "cause", "near", "xy_m", "link", "to_spot", "move_m", "dist_change_m", "text", "before_dbm", "after_dbm", "why"],
      "additionalProperties": false},
    "narration": {
      "type": "object",
      "properties": {"text": {"$ref": "common.json#/$defs/narration_text"}, "event_id": {"type": "string"}, "t": {"type": "integer", "minimum": 0},
                     "source": {"$ref": "common.json#/$defs/narration_source"}, "gen_ms": {"type": "number", "minimum": 0}},
      "required": ["text", "event_id", "t", "source", "gen_ms"], "additionalProperties": false},
    "teacher": {
      "$comment": "null when the camera is off.",
      "type": ["object", "null"],
      "properties": {"present": {"type": "boolean"}, "zone": {"$ref": "common.json#/$defs/zone"}, "motion": {"$ref": "common.json#/$defs/motion"}},
      "required": ["present", "zone", "motion"], "additionalProperties": false},
    "model": {
      "type": "object",
      "properties": {"trained": {"type": "boolean"}, "ver": {"type": "string"}, "train_s": {"type": "number", "minimum": 0},
                     "ms_per_decision": {"type": "number", "minimum": 0}, "windows": {"type": "integer", "minimum": 0},
                     "train_sessions": {"type": "array", "items": {"type": "string"}}, "training": {"$comment": "Only null is shown in the doc."}},
      "required": ["trained", "ver", "train_s", "ms_per_decision", "windows", "train_sessions", "training"], "additionalProperties": false},
    "board": {
      "type": "object",
      "properties": {"cpu_temp_c": {"type": "number"}, "cpu_mhz": {"type": "number", "minimum": 0}, "cpu_pct": {"type": "number", "minimum": 0}},
      "required": ["cpu_temp_c", "cpu_mhz", "cpu_pct"], "additionalProperties": false}
  },
  "required": ["cam", "router", "links", "health", "pred", "objects", "xray", "alert", "checkin", "advice", "narration", "teacher", "model", "board"],
  "unevaluatedProperties": false
}
