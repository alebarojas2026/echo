# LE Extended Advertising Report (7.7.65.13): a legacy ADV_NONCONN_IND from the west phone, RSSI -56
04 3e 21          # event packet, LE Meta, 33 parameter bytes
0d 01             # subevent 0x0D, Num_Reports 1
10 00             # Event_Type: legacy PDU, non-connectable, data complete
01                # Address_Type random
e1 e2 e3 e4 e5 e6 # Address (made up)
01 00             # Primary_PHY LE 1M, Secondary_PHY none
ff                # Advertising_SID: none
7f                # TX_Power: not available
c8                # RSSI -56
00 00             # Periodic_Advertising_Interval: none
00 00 00 00 00 00 00   # Direct_Address_Type, Direct_Address
07                # Data_Length 7
06 ff ff ff 52 53 57   # AD: Manufacturer Specific Data, company FFFF, "R" "S" "W"
